rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active(){ return signedIn() && me().status == 'active'; }
    function admin(){ return active() && me().role == 'admin'; }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role in ['telecaller','connector'] && request.resource.data.status == 'pending';
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if signedIn() && (admin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.status == resource.data.status));
      allow delete: if admin();
    }
    match /leads/{leadId} {
      allow create: if active() && request.resource.data.createdByUserId == request.auth.uid;
      allow read, update: if active() && (resource.data.createdByUserId == request.auth.uid || resource.data.assignedToUserId == request.auth.uid || admin());
      allow delete: if admin();
    }
    match /leadActivities/{activityId} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow read: if active() && (resource.data.userId == request.auth.uid || admin());
    }
  }
}